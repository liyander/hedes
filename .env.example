# Copy to .env. H.A.D.E.S connects to real services only; nothing here is required to start.

# Password for the seeded demo accounts owner / admin / builder (generated and logged if unset).
SEED_PASSWORD=IntegraDemo2026

# Production: set both explicitly (otherwise random keys are generated in backend/data/).
# JWT_SECRET=<48+ random characters>
# SECRET_ENCRYPTION_KEY=<python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
# COOKIE_SECURE=true

# Default: SQLite in backend/data. docker-compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://integra:secret@localhost:5432/integra

# false (default) = real services only. true = also mount the bundled mock APIs, seed sample integrations and show demo controls.
DEMO_MODE=false

# Public URL of this server (used for links in alerts). In DEMO_MODE the bundled mock APIs live under <PUBLIC_BASE_URL>/mock/
# and are the only private-network destinations integrations may call (PRIVATE_EGRESS_ALLOWLIST overrides, comma separated).
PUBLIC_BASE_URL=http://127.0.0.1:8000

# AI providers registered on first start (more can be added in the UI by the platform owner).
# The AI assistant needs a real provider (key here, or added in the UI as owner); the guided build pipeline can fall back to an offline model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Amazon Bedrock (Converse API). Optional here: you can also add it in AI Providers. Needs a model id enabled in your account and
# either AWS access keys or a Bedrock API key.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=

# Credentials may contain env:NAME instead of a secret, read from this server's environment at use time.
# For organisation credentials only the variables listed here may be used (comma separated), so nobody can point a
# credential at server secrets such as SECRET_ENCRYPTION_KEY. AI-provider keys (platform owner) may use any variable.
CONNECTION_ENV_VARS=
