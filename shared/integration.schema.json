{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.ai/schemas/integration-1.0.json",
  "title": "H.E.D.E.S integration configuration",
  "type": "object",
  "required": [
    "schema_version",
    "integration"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "integration": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "transport",
        "base_url",
        "authentication",
        "operations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "transport": {
          "const": "http"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://[^\\s/$.?#][^\\s]*$",
          "maxLength": 500
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "default_headers": {
          "$ref": "#/$defs/headers"
        },
        "authentication": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "bearer",
                "api_key_header",
                "api_key_query",
                "basic",
                "ssws",
                "oauth2_client_credentials",
                "oauth2_authorization_code",
                "aws_sigv4"
              ]
            },
            "credential_ref": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "header_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$"
            },
            "param_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "token_url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$",
              "maxLength": 500
            },
            "region": {
              "type": "string",
              "pattern": "^[a-z0-9-]{3,32}$"
            },
            "service": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,32}$"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_minute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          }
        }
      }
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "method",
        "path",
        "input_schema",
        "response"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\s]*$",
          "maxLength": 500
        },
        "safety": {
          "enum": [
            "read",
            "write",
            "destructive"
          ]
        },
        "idempotent": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "input_schema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path_params": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "query": {
              "type": "object"
            },
            "headers": {
              "$ref": "#/$defs/headers"
            },
            "json_body": {},
            "form_body": {
              "type": "object"
            }
          }
        },
        "pagination": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "page",
                "cursor",
                "offset",
                "link"
              ]
            },
            "page_param": {
              "type": "string"
            },
            "size_param": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "cursor_param": {
              "type": "string"
            },
            "next_cursor_path": {
              "type": "string"
            },
            "next_url_path": {
              "type": "string",
              "description": "link pagination: JSONPath of the next page's URL in the response body (else the Link header)"
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset_param": {
              "type": "string"
            },
            "total_path": {
              "type": "string"
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "backoff_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "max_wait_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 120
            },
            "jitter": {
              "type": "boolean"
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "json",
                "text"
              ]
            },
            "status_codes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "minItems": 1
            },
            "items_path": {
              "type": "string"
            },
            "mapping": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "optional_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "success": {
              "description": "For APIs that answer HTTP 200 even when the call failed (Slack: {\"ok\": false, \"error\": ...}).",
              "type": "object",
              "required": ["path", "equals"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "equals": {},
                "error_path": { "type": "string" },
                "detail_paths": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
                "error_classes": {
                  "type": "object",
                  "additionalProperties": { "enum": ["auth_invalid", "forbidden", "not_found", "rate_limited", "upstream_error", "request_rejected"] }
                }
              }
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 20000000
            }
          }
        },
        "ingest": {
          "type": "object",
          "required": [
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "category": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,31}$"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "event_id",
                  "timestamp",
                  "category",
                  "action",
                  "actor",
                  "target",
                  "outcome",
                  "severity",
                  "message",
                  "type",
                  "description",
                  "id",
                  "name",
                  "email",
                  "status",
                  "last_login",
                  "hostname",
                  "ip",
                  "os",
                  "owner",
                  "last_seen"
                ]
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "paths": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "maxItems": 6
                      },
                      "sep": {
                        "type": "string",
                        "maxLength": 8
                      },
                      "default": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "transform": {
                        "enum": [
                          "lower",
                          "upper",
                          "trim",
                          "title",
                          "iso_date",
                          "number",
                          "first",
                          "join_list",
                          "thresholds"
                        ]
                      },
                      "thresholds": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    }
                  }
                ]
              }
            },
            "value_maps": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "propertyNames": {
                "enum": [
                  "event_id",
                  "timestamp",
                  "category",
                  "action",
                  "actor",
                  "target",
                  "outcome",
                  "severity",
                  "message",
                  "type",
                  "description",
                  "id",
                  "name",
                  "email",
                  "status",
                  "last_login",
                  "hostname",
                  "ip",
                  "os",
                  "owner",
                  "last_seen"
                ]
              }
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "enum": [
                  "event_id",
                  "timestamp",
                  "category",
                  "action",
                  "actor",
                  "target",
                  "outcome",
                  "severity",
                  "message",
                  "type",
                  "description",
                  "id",
                  "name",
                  "email",
                  "status",
                  "last_login",
                  "hostname",
                  "ip",
                  "os",
                  "owner",
                  "last_seen"
                ]
              }
            },
            "incremental": {
              "type": "object",
              "required": [
                "param"
              ],
              "additionalProperties": false,
              "properties": {
                "param": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "format": {
                  "enum": [
                    "iso8601",
                    "iso8601_millis",
                    "epoch_seconds",
                    "epoch_millis",
                    "date"
                  ]
                },
                "overlap_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
                },
                "end_param": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "initial_lookback_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650
                },
                "max_window_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650
                }
              }
            },
            "schedule": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interval_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "cron": {
                  "type": "string",
                  "pattern": "^\\S+( \\S+){4}$",
                  "maxLength": 64
                }
              }
            },
            "entity": {
              "enum": [
                "event",
                "user",
                "device"
              ]
            }
          }
        }
      }
    }
  }
}
