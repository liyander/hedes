{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.ai/schemas/workflow-1.0.json",
  "title": "H.E.D.E.S workflow graph",
  "type": "object",
  "required": ["trigger", "nodes"],
  "additionalProperties": false,
  "properties": {
    "trigger": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["manual", "webhook", "schedule"] },
        "interval_minutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "description": { "type": "string" },
        "sample": { "type": "object" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "tool"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
          "label": { "type": "string", "maxLength": 120 },
          "tool": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$" },
          "inputs": { "type": "object" },
          "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "when": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["left", "op"],
              "additionalProperties": false,
              "properties": {
                "left": { "type": "string" },
                "op": { "enum": ["eq", "neq", "contains", "not_contains", "exists", "not_exists", "gt", "lt", "in"] },
                "right": {}
              }
            }
          },
          "on_failure": { "enum": ["stop", "continue"] }
        }
      }
    },
    "layout": { "type": "object" }
  }
}
